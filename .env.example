NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
DATABASE_URL=postgresql://carbonproof:carbonproof@localhost:5432/carbonproof?schema=public
USE_IN_MEMORY=true
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=info
JWT_SECRET=replace-with-a-long-development-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
FILE_STORAGE_ROOT=./data/storage
MAX_UPLOAD_SIZE=10485760
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_SIGNER_PRIVATE_KEY=
AI_PROVIDER=local
AI_TIMEOUT_MS=3000
